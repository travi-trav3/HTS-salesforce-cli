<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <name>Pipeline Funnel (Open)</name>
    <description>The funnel at a glance: open opportunities grouped by stage, showing deal count, raw Amount, and weighted Expected Revenue per stage. Read top-to-bottom for where deals concentrate; compare raw vs weighted for a realistic forecast. Org-wide, summary only.</description>
    <reportType>Opportunity</reportType>
    <format>Summary</format>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <columns>
        <field>AMOUNT</field>
        <aggregateTypes>Sum</aggregateTypes>
    </columns>
    <columns>
        <field>EXP_AMOUNT</field>
        <aggregateTypes>Sum</aggregateTypes>
    </columns>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>STAGE_NAME</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <filter>
        <criteriaItems>
            <column>CLOSED</column>
            <operator>equals</operator>
            <value>false</value>
        </criteriaItems>
    </filter>
</Report>
