<?xml version="1.0" encoding="UTF-8"?>
<Report xmlns="http://soap.sforce.com/2006/04/metadata">
    <name>Sales Rep Scorecard (Last 90 Days)</name>
    <description>Per-rep performance over the trailing 90 days: total won, deal count, average deal size, and win rate. The core "how is each rep performing" view, org-wide.</description>
    <reportType>Opportunity</reportType>
    <format>Summary</format>
    <scope>organization</scope>
    <showDetails>false</showDetails>
    <showGrandTotal>true</showGrandTotal>
    <showSubTotals>true</showSubTotals>
    <aggregates>
        <calculatedFormula>Is_Won_Number__c:SUM/RowCount</calculatedFormula>
        <datatype>Percent</datatype>
        <developerName>WIN_RATE</developerName>
        <isActive>true</isActive>
        <isCrossBlock>false</isCrossBlock>
        <masterLabel>Win Rate</masterLabel>
        <scale>1</scale>
    </aggregates>
    <columns>
        <field>AMOUNT</field>
        <aggregateTypes>Sum</aggregateTypes>
        <aggregateTypes>Average</aggregateTypes>
    </columns>
    <columns>
        <field>Is_Won_Number__c</field>
        <aggregateTypes>Sum</aggregateTypes>
    </columns>
    <groupingsDown>
        <dateGranularity>Day</dateGranularity>
        <field>FULL_NAME</field>
        <sortOrder>Asc</sortOrder>
    </groupingsDown>
    <filter>
        <criteriaItems>
            <column>CLOSED</column>
            <operator>equals</operator>
            <value>true</value>
        </criteriaItems>
        <criteriaItems>
            <column>CLOSE_DATE</column>
            <operator>greaterOrEqual</operator>
            <value>N_DAYS_AGO:90</value>
        </criteriaItems>
    </filter>
</Report>
